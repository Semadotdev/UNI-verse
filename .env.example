# Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.qhyqxhaaytytbuvuqpfl.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.qhyqxhaaytytbuvuqpfl.supabase.co:5432/postgres"

# Optional: separate shadow DB for `prisma migrate dev` validation.
# Never point this at the shared database — use a local/throwaway Postgres.
SHADOW_DATABASE_URL="postgresql://postgres:[PASSWORD]@localhost:5432/universe_shadow"

# Set to "true" to allow destructive Prisma commands (migrate dev/reset,
# db push --accept-data-loss) against the shared Supabase DB. DON'T.
ALLOW_DESTRUCTIVE_MIGRATIONS="false"

# Backups
BACKUP_RETENTION="14"

# Supabase
SUPABASE_URL="https://qhyqxhaaytytbuvuqpfl.supabase.co"
SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# Next.js Public Supabase (exposed to client)
NEXT_PUBLIC_SUPABASE_URL="https://qhyqxhaaytytbuvuqpfl.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"

# App
NODE_ENV="development"
LOG_LEVEL="debug"
