generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  name          String?
  avatarUrl     String?
  birthDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  library       Library[]
  folders       Folder[]
  history       ReadingHistory[]
  settings      UserSettings?
  mangaSettings MangaSettings[]
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Library[]

  @@unique([userId, name])
  @@index([userId])
}

model Library {
  id          String   @id @default(cuid())
  userId      String
  providerId  String
  mangaId     String
  title       String
  coverUrl    String
  status      String   @default("unknown")
  categories  String[] @default([])
  folderId    String?
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  bookmarks   Bookmark[]

  @@unique([userId, providerId, mangaId])
  @@index([userId])
  @@index([folderId])
}

model Bookmark {
  id          String   @id @default(cuid())
  libraryId   String
  chapterId   String
  chapterNum  Float
  title       String?
  read        Boolean  @default(false)
  progress    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([libraryId, chapterId])
  @@index([libraryId])
}

model ReadingHistory {
  id          String   @id @default(cuid())
  userId      String
  providerId  String
  mangaId     String
  chapterId   String
  chapterNum  Float
  title       String?
  coverUrl    String?
  progress    Float    @default(0)
  completed   Boolean  @default(false)
  readAt      DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, mangaId])
  @@index([userId, readAt])
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("dark")
  readerMode      String   @default("paged")
  readingDirection String  @default("ltr")
  backgroundColor String   @default("#000000")
  brightness      Float    @default(1.0)
  padding         Float    @default(0)
  language        String   @default("en")

  readingMode      String   @default("paged")
  scaleType        String   @default("contain")
  zoomStartPosition String  @default("center")
  showPageNumber   Boolean  @default(true)
  tapZoneLayout    String   @default("disabled")
  cropBorders      Boolean  @default(false)
  sidePadding      Float    @default(0)
  doubleTapZoom    Boolean  @default(true)
  splitWidePages   Boolean  @default(true)
  pagePreloadCount Int      @default(2)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MangaSettings {
  id              String   @id @default(cuid())
  userId          String
  providerId      String
  mangaId         String
  readingMode     String?
  scaleType       String?
  readingDirection String?
  backgroundColor String?
  brightness      Float?
  cropBorders     Boolean?
  sidePadding     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, mangaId])
  @@index([userId])
}

model Provider {
  id              String   @id @default(cuid())
  packageName     String   @unique
  name            String
  providerId      String
  version         String
  lang            String   @default("en")
  description     String?
  icon            String?
  nsfw            Boolean  @default(false)
  enabled         Boolean  @default(true)
  hasSearch       Boolean  @default(true)
  hasPopular      Boolean  @default(false)
  hasLatest       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}
